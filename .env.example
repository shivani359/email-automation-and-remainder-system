# Copy this file to ".env" and fill in your values. NEVER commit ".env".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail use an "App Password" (needs 2-Step Verification), NOT your normal password
SMTP_PASSWORD=your_16_char_app_password
SENDER_NAME=Email Automation Demo

# true = simulate only (nothing is sent). Set to false only when you are ready.
DRY_RUN=true
